# Claves de demostracion local; puedes cambiarlas ANTES del primer inicio.
MYSQL_ROOT_PASSWORD=RootDemo2026_local
MYSQL_PASSWORD=DashDemo2026_local

# Ubicación consultada en Open-Meteo (ejemplo: Ciudad de México).
LATITUDE=19.4326
LONGITUDE=-99.1332
LOCATION_NAME=Ciudad de México

# Frecuencia de consulta; el recolector impone un mínimo de 60 segundos.
COLLECT_INTERVAL_SECONDS=900
